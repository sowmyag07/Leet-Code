class Solution:
    def isPerfectSquare(self, num: int) -> bool:
        low = 1
        high = num
        while low <= high:
           mid = (low + high )//2
           x = mid * mid
           if x == num:

            return True
           elif x < num:

            low = mid + 1
           else:
            high = mid - 1
        return False   


        